<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/hieu_ung_nhan">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/xanh_dam"
                android:startColor="@color/xanh_chinh" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/trang" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</ripple>