<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/nen_the"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nhan_thoi_gian_muc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="04/10/2026 10:30"
                android:textColor="@color/chu_phu"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/nhan_chi_so_bmi_muc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="22,5"
                    android:textColor="@color/mau_binh_thuong"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/nhan_phan_loai_muc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/nen_nhan_phan_loai"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:text="Bình thường"
                    android:textColor="@color/trang"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/nhan_chi_tiet_muc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="170 cm • 65 kg"
                android:textColor="@color/chu_phu"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/nut_chia_se"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/nen_nut_phu"
            android:clickable="true"
            android:drawableStart="@drawable/bieu_tuong_chia_se"
            android:drawablePadding="6dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:text="Chia sẻ"
            android:textColor="@color/mau_nhan_manh"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.cardview.widget.CardView>