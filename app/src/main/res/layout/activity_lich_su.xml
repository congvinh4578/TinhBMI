<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bo_cuc_goc_lich_su"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nen_man_hinh"
    android:orientation="vertical">

    <!-- Tiêu đề -->
    <LinearLayout
        android:id="@+id/khu_vuc_tieu_de_lich_su"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/nen_tieu_de"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="22dp">

        <ImageButton
            android:id="@+id/nut_quay_lai"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/nen_nut_tron"
            android:contentDescription="Quay lại"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/bieu_tuong_quay_lai" />

        <TextView
            android:id="@+id/nhan_tieu_de_lich_su"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Lịch sử đo BMI"
            android:textColor="@color/trang"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nut_xoa_lich_su"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/nen_nut_xoa_lich_su"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingTop="9dp"
            android:paddingEnd="16dp"
            android:paddingBottom="9dp"
            android:text="Xóa tất cả"
            android:textColor="@color/trang"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/khung_danh_sach_lich_su"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:padding="12dp" />

        <TextView
            android:id="@+id/nhan_trong_lich_su"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:padding="32dp"
            android:text="Chưa có lịch sử đo nào.\nHãy quay lại và bấm tính BMI nhé!"
            android:textColor="@color/chu_phu"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>